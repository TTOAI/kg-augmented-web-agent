# LLM provider: "anthropic" (기본값) 또는 "openai"
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6   # 선택사항, 기본값 사용 권장

# OpenAI (LLM_PROVIDER=openai 시 사용)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# LLM temperature — 실험 재현성을 위해 0 권장.
# 비워두면 provider 기본값(보통 1.0) 사용 → 같은 intent도 실행마다 다른 plan을 만들 수 있다.
# 논문 baseline/ablation 측정에는 반드시 0으로 고정.
# LLM_TEMPERATURE=0
